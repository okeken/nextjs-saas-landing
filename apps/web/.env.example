# All optional: the app runs without any of these. Set them before you deploy.

# Public site URL, no trailing slash. On Vercel it defaults to your production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=MySaas
NEXT_PUBLIC_TWITTER_HANDLE=@mysaas
NEXT_PUBLIC_TAG_LINE=Production-ready marketing system
NEXT_PUBLIC_CURRENCY=USD

# Google Search Console, "HTML tag" method: paste the tag's content value.
GOOGLE_SITE_VERIFICATION=

ENABLE_EXPERIMENTAL_COREPACK=1
